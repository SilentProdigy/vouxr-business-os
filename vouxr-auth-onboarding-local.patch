+          </p>
+        </div>
+        <form action={signOutAction}>
+          <button className="inline-flex items-center gap-2 rounded-2xl border border-slate-200 px-4 py-2.5 text-sm font-black text-slate-700 hover:bg-slate-50">
+            <LogOut className="h-4 w-4" />
